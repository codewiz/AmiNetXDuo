@@ -79,15 +79,23 @@ static struct m68k_args mycum, othercum;
 
 bool m68k_is_ok_for_sibcall(tree decl, tree exp);
 /**
- * Sibcall is only ok, if max regs d0/d1/a0 are used.
- * a1 is used for the sibcall
+ * Sibcall is only ok, if max regs d0/d1/a0 are used;
  * others might be trashed due to stack pop.
+ * a0 only for a direct call that m68k_symbolic_jump can branch to: any
+ * other target (an indirect call, or a direct one with -m68000 -fbaserel,
+ * -resident or -mpcrel) is loaded into STATIC_CHAIN_REGNUM, which is a0
+ * (m68k_legitimize_sibcall_address), and would replace the argument.
  */
 bool m68k_is_ok_for_sibcall(tree decl, tree exp)
 {
   tree fntype = decl ? TREE_TYPE (decl) : TREE_TYPE (TREE_TYPE (CALL_EXPR_FN (exp)));
   if (othercum.fntype == fntype)
-    return (othercum.regs_already_used & ~0x010103) == 0;
+    {
+      long allowed = 0x010003;
+      if (decl && m68k_symbolic_jump != NULL)
+	allowed |= 1 << STATIC_CHAIN_REGNUM;
+      return (othercum.regs_already_used & ~allowed) == 0;
+    }
   return false;
 }
 
